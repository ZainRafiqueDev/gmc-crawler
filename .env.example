# LLM provider for the LLM-graded + vision checks (Phase 1 step 5, Phase B images).
# "claude" or "openai" — deterministic checks run fine with neither key set.
LLM_PROVIDER=claude

# Claude API (Anthropic) — used when LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI API — used when LLM_PROVIDER=openai. Needs a Structured-Outputs-
# and vision-capable model (gpt-4o or newer).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Phase C's policy RAG index always uses OpenAI embeddings regardless of
# LLM_PROVIDER (Claude has no embeddings API) — needs OPENAI_API_KEY set
# even when LLM_PROVIDER=claude for grading.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# WooCommerce REST API — optional. Leave blank to fall back to scraping public
# product pages instead of the /wp-json/wc/v3/products endpoint.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# How many product pages the LLM editorial-quality/prohibited-content checks
# grade per audit. Scales with catalog size (min 5, ~5% of reachable product
# pages) up to this cap, risk-weighted rather than first-N-crawled. Hard
# ceiling 50 regardless of what's set here (see app/config.py).
LLM_PRODUCT_SAMPLE_CAP=15

# How many product pages the crawler will explore per category before
# skipping further product URLs in that same category - category-listing
# pages themselves are always crawled regardless. Hard ceiling 200.
CRAWL_MAX_PRODUCT_PAGES_PER_CATEGORY=30

# Crawl limits (sane defaults, override per-run via CLI flags too).
# Hard-capped regardless of what's set here or passed via CLI/API - see
# HARD_MAX_PAGES/HARD_MAX_DEPTH/HARD_MAX_CONCURRENCY in app/config.py.
CRAWL_MAX_PAGES=150
CRAWL_MAX_DEPTH=4
CRAWL_CONCURRENCY=4

# Minimum delay (seconds) between requests to the same domain - politeness/
# rate-limit avoidance so this crawler's own pace doesn't trip a target
# site's rate limiting. Clamped to [0, 30].
CRAWL_DOMAIN_MIN_DELAY_SECONDS=0.5

# Opt-in BYO residential/rotating-proxy support - OFF by default (leave
# blank). This tool does not operate or bundle any proxy infrastructure of
# its own; these just let you point it at a proxy service you already have,
# for sites whose anti-automation defenses block this tool's own IP/browser
# fingerprint outright (see app/proxy_config.py). Single rotating-gateway
# shape:
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# ...or a comma-separated pool of full proxy URLs to round-robin client-side
# (takes precedence over PROXY_SERVER if set):
#   PROXY_POOL=http://user:pass@proxy1.example:8000,http://user:pass@proxy2.example:8001
PROXY_POOL=

# Opt-in, off by default (empty = no change to any request this tool
# makes). JSON object of extra HTTP headers added to every request this
# tool's browser makes. Never a substitute for or interaction with the SSRF
# guard - only ever adds a header to a request the guard already allowed.
# Exists for the rare case where the *target itself* requires a specific
# header to be reachable at all (a staging-environment gate, or a tunnel
# provider's own anti-abuse interstitial - see
# validation/purchase_journey_test_store/README.md for a real example:
# ngrok's free-tier warning page). Real GMC store audits never need this.
#   CRAWL_EXTRA_HEADERS={"ngrok-skip-browser-warning": "true"}
CRAWL_EXTRA_HEADERS=

# Also hard-capped (see app/config.py) - a full audit is aborted past this
# many seconds; a single image download over this many bytes is aborted.
AUDIT_TIMEOUT_SECONDS=1800
MAX_IMAGE_BYTES=15728640

# Output
REPORT_OUTPUT_DIR=./reports

# Monitoring subsystem (monitor.py) — registered stores, page snapshots for
# change detection, audit run history. Defaults to a local SQLite file, zero
# setup needed. Point at Postgres/Supabase in production, e.g.:
#   postgresql+asyncpg://user:pass@host:5432/gmc_monitor
DATABASE_URL=sqlite+aiosqlite:///./gmc_monitor.db

# How often (days) the independent GMC policy-source watcher re-checks the
# real Help Center pages, regardless of any store's monitoring schedule.
DEFAULT_POLICY_WATCH_INTERVAL_DAYS=7

# Retention: neither audit_jobs nor audit_runs is unbounded. audit_runs
# (monitored-store history) keeps only the most recent N full audits per
# store; audit_jobs (ad-hoc "Run Audit" jobs, not tied to a store) has no
# natural per-entity grouping, so it's pruned by age instead.
AUDIT_RUN_RETENTION_COUNT=10
AUDIT_JOB_RETENTION_DAYS=30

# Frontend API (app/api/main.py, served to frontend/). Must match wherever
# the Next.js app is actually served from.
API_CORS_ORIGIN=http://localhost:3000
AUDIT_RATE_LIMIT_MAX_REQUESTS=5
AUDIT_RATE_LIMIT_WINDOW_SECONDS=3600
