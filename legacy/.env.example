# Store connection — leave blank to run in mock/demo mode against seeded catalog data
STORE_PLATFORM=              # mock | woocommerce | shopify   (default: mock)
STORE_URL=
STORE_API_KEY=
STORE_API_SECRET=

# LLM provider — system defaults to local Ollama if OPENAI_API_KEY is blank
LLM_PROVIDER=ollama          # ollama | openai
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Google Merchant Center — leave blank until ready; system still runs full compliance
# checking and reporting, it just skips the auto-connect step and logs why
GMC_MERCHANT_ID=
GMC_SERVICE_ACCOUNT_JSON_PATH=

# Notifications
ALERT_EMAIL_TO=
RESEND_API_KEY=

# API auth — protects /scan and /dashboard/alerts (real catalog/violation data,
# and a live claimwebsite trigger once GMC is configured). Blank is fine for
# local/mock dev only; set a long random value before deploying anywhere
# reachable beyond localhost.
API_AUTH_TOKEN=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gmc_compliance
